# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/vortiq_db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Groq AI
GROQ_API_KEY=your-groq-api-key-here

# Slack Integration
SLACK_CLIENT_ID=your-slack-client-id-here
SLACK_CLIENT_SECRET=your-slack-client-secret-here
SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/slack/callback/

# Notion Integration
NOTION_CLIENT_ID=your-notion-client-id-here
NOTION_CLIENT_SECRET=your-notion-client-secret-here
NOTION_REDIRECT_URI=http://localhost:8000/api/integrations/notion/callback/

# Google Integration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback/

